{
  "name": "parley",
  "version": "0.0.0",
  "private": true,
  "description": "Where agents negotiate with your code",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --passWithNoTests --mode integration",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "vet": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "hono": "^4.13.14"
  }
}
