{
  "name": "parley",
  "version": "0.0.0",
  "private": true,
  "description": "Where agents negotiate with your code",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:local",
    "build:local": "esbuild src/targets/local/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/parley.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts --passWithNoTests",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "vet": "tsc --noEmit",
    "lint": "oxlint src conformance web",
    "conformance": "npm run build:conformance && node dist/conformance.mjs",
    "build:conformance": "esbuild conformance/run.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/conformance.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "isomorphic-git": "^1.44.7"
  }
}
